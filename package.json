
{
  "name": "maru-ghar",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www',{recursive:true});for(const f of fs.readdirSync('.'))if(/^(index|admin|download|privacy)\\.html$/.test(f)&&fs.existsSync(f))fs.copyFileSync(f,'www/'+f);for(const f of fs.readdirSync('.'))if(/\\.(js|json|webmanifest|png|svg|jpg|jpeg|webp)$/.test(f)&&!['package.json'].includes(f))fs.copyFileSync(f,'www/'+f);\""
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/android": "^7.4.3"
  }
}
